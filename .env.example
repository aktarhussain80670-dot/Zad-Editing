# Local Whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=auto
WHISPER_DOWNLOAD_ROOT=~/.cache/whisper
WHISPER_ALLOW_MODEL_DOWNLOAD=false

# Optional media retrieval credentials; never used for AI decisions
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Video output profile
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=60
VIDEO_CODEC=libx264
VIDEO_PRESET=slow
VIDEO_CRF=16
VIDEO_PIXEL_FORMAT=yuv420p
VIDEO_MIN_DURATION=1
VIDEO_MAX_DURATION=180

# Feature control
ENABLE_SUBTITLES=true
ENABLE_MOTION_GRAPHICS=true
ENABLE_TRANSITIONS=true
ENABLE_SOUND_EFFECTS=false 
ENABLE_BACKGROUND_MUSIC=false 
ENABLE_EXTERNAL_CLIPS=false
ENABLE_EXTERNAL_IMAGES=false
PRESERVE_ORIGINAL_VOICEOVER=true
AUDIO_NORMALIZATION=true
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK=-1.0
AUDIO_FADE_SECONDS=0.35
MUSIC_VOLUME=0.12
SOUND_EFFECT_VOLUME=0.25
MEDIA_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BYTES=250000000
MAX_INPUT_BYTES=2000000000
HYPERFRAMES_COMMAND=hyperframes
DELETE_TEMP_FILES=true
DELETE_PROCESSED_VOICEOVER=false
PRESERVE_REFERENCE_VIDEOS=true
OUTPUT_FORMAT=mp4
OUTPUT_DIRECTORY=storage/final_video
